# Dart / Pub
.dart_tool/
.packages
pubspec_overrides.yaml

# Backend
.revali*
apps/zonai/lib/gen/
apps/web/lib/gen/
libs/zonai_client/lib/gen/

# Flutter
build/
.flutter-plugins
.flutter-plugins-dependencies
.fvm

# Tests & coverage
coverage/
.test_coverage.dart

# Generated API docs
doc/api/

# FVM (commit .fvm/fvm_config.json and .fvm/release)
.fvm/flutter_sdk

# IDE
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs & temp
*.log
*.tmp
*.swp
*~

# Graphify knowledge-graph output
**/graphify-out/

# Secrets (adjust if you commit non-secret env files)
.env
.env.*
!.env.example
!apps/compat/.env

# Local / dev databases (e.g. zonai SQLite under apps/db/data/)
*.sqlite
*.sqlite*
*.sqlite3
*.db

apps/web/.cursor
*.stop
.serve.lock

# Platform-specific Zonai build artifacts (rebuilt by compile/serve)
**/.zonai/executables/
**/.zonai/lib/

# Runtime data (sqlite db, uploaded photos/recordings, the replay-viewer
# static build) — never source, can get large (recordings/replay-viewer
# especially), must never be committed.
**/.zonai/data/
zonai.sqlite*

# AI stuff
.llm_chat
.game_loop
# llm_chat identity for this project
.llm_chat/

# machine-local hook config (absolute paths)
.claude/settings.local.json
**/gen/**

# ...except the vendored raindrop source: raindrop is a private submodule
# (libs/raindrop), so anyone without access to it can't regenerate this --
# committing the vendor output lets them build zonai from a plain clone.
!libs/zonai_schema/lib/gen/raindrop/
!libs/zonai_schema/lib/gen/raindrop/**